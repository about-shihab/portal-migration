	<queryString language="SQL">
		<![CDATA[SELECT mv.code
     , mv.pre_cust_code 
     , ct.title as cust_type
     , mv.cust_name
     , mv.zone
     , mv.mobile_no
     , mv.address
     , TO_CHAR(SYSDATE, 'dd/mm/yyyy hh:mi AM')  AS current_date
  FROM meter_unoin_dom_cust_view mv
 LEFT JOIN cust_type ct ON mv.cust_type_id = ct.id
 WHERE mv.code = $P{cust_code}]]>
	</queryString>
