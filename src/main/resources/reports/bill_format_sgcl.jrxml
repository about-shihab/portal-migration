		<property name="com.jaspersoft.studio.field.name" value="TOTAL_CONSUMPTION"/>
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_CONSUMPTION"/>
	</field>
	<field name="GAS_BILL" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="GAS_BILL"/>
		<property name="com.jaspersoft.studio.field.label" value="GAS_BILL"/>
	</field>
	<field name="AVG_BILL" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="AVG_BILL"/>
		<property name="com.jaspersoft.studio.field.label" value="AVG_BILL"/>
	</field>
	<field name="MIN_BILL" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="MIN_BILL"/>
