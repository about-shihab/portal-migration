		<property name="com.jaspersoft.studio.field.name" value="ADDRESS"/>
		<property name="com.jaspersoft.studio.field.label" value="ADDRESS"/>
	</field>
	<field name="DEMAND_CHARGE" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="DEMAND_CHARGE"/>
		<property name="com.jaspersoft.studio.field.label" value="DEMAND_CHARGE"/>
	</field>
	<field name="LAST_DATE_PAYMENT" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.name" value="LAST_DATE_PAYMENT"/>
		<property name="com.jaspersoft.studio.field.label" value="LAST_DATE_PAYMENT"/>
	</field>
	<field name="ISSUE_DATE" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.name" value="ISSUE_DATE"/>
		<property name="com.jaspersoft.studio.field.label" value="ISSUE_DATE"/>
	</field>
	<field name="PRE_CUST_CODE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="PRE_CUST_CODE"/>
		<property name="com.jaspersoft.studio.field.label" value="PRE_CUST_CODE"/>
	</field>
