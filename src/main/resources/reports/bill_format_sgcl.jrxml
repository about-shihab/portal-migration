		<property name="com.jaspersoft.studio.field.name" value="ADJUST_SURCHARGE_DESCRIPTION"/>
		<property name="com.jaspersoft.studio.field.label" value="ADJUST_SURCHARGE_DESCRIPTION"/>
	</field>
