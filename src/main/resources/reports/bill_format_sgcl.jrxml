		<property name="com.jaspersoft.studio.field.name" value="ACTUAL_MINIMUM_LOAD"/>
		<property name="com.jaspersoft.studio.field.label" value="ACTUAL_MINIMUM_LOAD"/>
	</field>
	<field name="MAX_LOAD" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="MAX_LOAD"/>
		<property name="com.jaspersoft.studio.field.label" value="MAX_LOAD"/>
	</field>
	<field name="MONTLHY_APPROVED_LOAD" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="MONTLHY_APPROVED_LOAD"/>
		<property name="com.jaspersoft.studio.field.label" value="MONTLHY_APPROVED_LOAD"/>
	</field>
	<field name="MINIMUM_GAS_LOAD" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="MINIMUM_GAS_LOAD"/>
		<property name="com.jaspersoft.studio.field.label" value="MINIMUM_GAS_LOAD"/>
	</field>
