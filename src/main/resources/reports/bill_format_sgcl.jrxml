<!-- Created with Jaspersoft Studio version 6.20.3.final using JasperReports Library version 6.20.3-415f9428cffdb6805c6f85bbb29ebaf18813a2ab  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="testBillReport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="88454cfa-63a9-4d35-a90a-69fba1c89656">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="720"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="db.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cust_code" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="bill_month" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="bill_year" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="IMAGE_DIR" class="java.lang.String"/>
	<parameter name="zone" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="cust_type_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="copy_name" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
    cust_code code,
    CUST_NAME,
    cust_type,
case when cust_type_id = 7 then 'Domestic Bill' when cust_type_id = 703 then 'Commercial Bill' else 'Industrial Bill' end bill_cat_name,
    cust_type_id "cust_type_id",
    PERIOD_FROM,
    PERIOD_to,
    "bill_number",
    PHONE_NO,is_bulk,
    ZONE,
    ACTUAL_MINIMUM_LOAD,
    max_load,
   montlhy_approved_load,
   MINIMUM_GAS_LOAD,
   load_per_hour,
address,
demand_charge,
    LAST_DATE_PAYMENT,
    ISSUE_DATE,
    PRE_CUST_CODE,
 REGEXP_REPLACE (ADJUST_SURCHARGE_DESCRIPTION,
                              '(, for\d|, for[^[:alnum:]]|, for$)',
                              ' : ',
                              1,
                              0,
                              'i') ADJUST_SURCHARGE_DESCRIPTION,
    consumption,
    MIXED_CONSUMPTION,
    AVG_CONSUMPTION,
    ADJUST_CONSUMPTION,
    EVC_ADJUSTED_CONSUMPTION,
    TOTAL_CONSUMPTION,
    gas_bill,
    AVG_BILL,
    MIN_BILL,
    adjustment,
    METER_CHARGE_AMOUNT,
    SURCHARGE_AMOUNT,
    VAT_EXEMPTION,
    VAT_AMOUNT,
    ADVANCE_AMOUNT,
    CURRENT_TOTAL,
    "bill_month",
    bill_month_sub,
    bill_year,
    main_q.gas_rate_dist.gas_rate gas_rate,
    main_q.gas_rate_dist.gas_rate_vat gas_rate_vat,
    defualter_date,
    spelOut,
    "dep",
nvl((SELECT max(EXEMPTED_PERCENTAGE)
  FROM VAT_EXEMPTION_INFO
 WHERE     cust_code = $P{cust_code}
       AND (    TO_DATE ('01/' || TRIM (TO_CHAR (bill_month_sub, '09')) || '/' || bill_year,
                         'dd/mm/yyyy') <=
                   TRUNC (
                      NVL (
                         end_date,
                         LAST_DAY (
                            TO_DATE (
                                  '01/'
                               || TRIM (TO_CHAR (bill_month_sub, '09'))
                               || '/'
                               || bill_year,
                               'dd/mm/yyyy'))))
            AND TRUNC (start_date) <=
                   LAST_DAY (
                      TO_DATE (
                         '01/' || TRIM (TO_CHAR (bill_month_sub, '09')) || '/' || bill_year,
                         'dd/mm/yyyy')))),0)
vat_exp_percent,
    COMMENTS adj_foot_note,
         BILL_F.CAT_NAME
 from (
(
--main query
SELECT C.CODE cust_code,
       C.CUST_NAME,ADJUST_SURCHARGE_DESCRIPTION,
       cty.remarks cust_type,
       cty.id cust_type_id,
       cmv.PERIOD_FROM,
       cmv.PERIOD_to,
       cb.id "bill_number",
       C.PHONE_NO,
       C.ZONE,
       CB.ACTUAL_MINIMUM_LOAD,
       cv.max_load,
   cv.montlhy_approved_load,
   cv.MINIMUM_GAS_LOAD,
   cv.load_per_hour,
cv.c_address as address,nvl(c.is_bulk,0) is_bulk,
cb.demand_charge,
       CB.LAST_DATE_PAYMENT,
       CB.ISSUE_DATE,
       C.PRE_CUST_CODE,
       nvl(cmv.consumption,0) consumption,
       nvl(cmv.MIXED_CONSUMPTION,0) MIXED_CONSUMPTION,
       nvl(cmv.AVG_CONSUMPTION,0) AVG_CONSUMPTION,
case when (cb.bill_month || cb.bill_year) < to_number('082021') then
       nvl(cmv.ADJUST_CONSUMPTION,0) else  nvl(cmv.ADJUST_CONSUMPTION,0)+nvl(cmv.EVC_ADJUSTED_CONSUMPTION,0) end ADJUST_CONSUMPTION,
       nvl(cmv.EVC_ADJUSTED_CONSUMPTION,0) EVC_ADJUSTED_CONSUMPTION,
case when (cb.bill_month || cb.bill_year) < to_number('082021') then
       nvl(cmv.TOTAL_CONSUMPTION,0) else nvl(cmv.TOTAL_CONSUMPTION,0)+ nvl(cmv.EVC_ADJUSTED_CONSUMPTION,0) end TOTAL_CONSUMPTION,
       CB.BILL_AMOUNT gas_bill,
       CB.AVG_BILL,
       CB.MIN_BILL,
       (CB.ADJUST_GAS_BILL + CB.ADJUST_METER_RENT + CB.ADJUST_OTHER)
          adjustment,
       CB.METER_CHARGE_AMOUNT,
       CB.SURCHARGE_AMOUNT,
       CB.VAT_EXEMPTION,
       round(nvl(cb.VAT_AMOUNT,0),0) VAT_AMOUNT,
       CB.ADVANCE_AMOUNT,
       CB.CURRENT_TOTAL,
       substr(MD.MONTH_NAME,0,3) || '-' || cb.bill_year "bill_month",
       cb.bill_month bill_month_sub,
       cb.bill_year,
       (SELECT get_gas_rate_date_wise4report (
                     '01/'
                  || TO_CHAR (CB.BILL_MONTH, '09')
                  || '/'
                  || CB.BILL_YEAR,
                  LAST_DAY (
                     TO_DATE (
                           '01/'
                        || TO_CHAR (CB.BILL_MONTH, '09')
                        || '/'
                        || CB.BILL_YEAR,
                        'dd/mm/yyyy')),
                  C.CUST_TYPE_ID)
          FROM DUAL)
          gas_rate_dist,
    ((cb.issue_date+cty.DAYS_FOR_DEFUALTER)-1) defualter_date,
       NVL ( (SELECT spel_out (cb.CURRENT_TOTAL) FROM DUAL), 'Zero') spelOut,
(SELECT SUBSTR(DEPARTMENT,7,5) FROM CUSTOMER_ZONE WHERE zone_name=c.zone) "dep",
cb.COMMENTS,
                  C.IS_ACTIVE
  FROM cust c
       JOIN customer_bill cb ON c.code = cb.cust_code
       JOIN month_day md ON md.id = cb.bill_month
       join CUST_ADDRESS_VIEW cv ON cv.code = cb.cust_code
       JOIN
       CUST_METER_READING_SUM_VIEW cmv
          ON     cmv.CUST_CODE = cb.cust_code
             AND cb.bill_month = cmv.bill_month
             AND cb.bill_year = cmv.bill_year
       join cust_type cty on c.cust_type_id=cty.id
WHERE c.zone=$P{zone}
 and (  $P{cust_code} is null or c.code =$P{cust_code})
 AND cb.bill_month = $P{bill_month}
 and c.cust_type_id=$P{cust_type_id}

 AND cb.bill_year = $P{bill_year}   )

union all
-- Applied Disconnected customers
(SELECT C.CODE cust_code,
       C.CUST_NAME,ADJUST_SURCHARGE_DESCRIPTION,
       cty.remarks cust_type,
       cty.id cust_type_id,
       TO_DATE (
             '01'
          || '/'
          || cb.BILL_MONTH
          || '/'
          || TO_CHAR (cb.bill_year, '9999'),
          'dd/mm/yyyy')
          PERIOD_FROM,
       LAST_DAY (
          TO_DATE ('01' || '/' || cb.BILL_MONTH || '/' || cb.bill_year,
                   'dd/mm/yyyy'))
          PERIOD_to,
       cb.id "bill_number",
       C.PHONE_NO,
       C.ZONE,
       CB.ACTUAL_MINIMUM_LOAD,
           cv.max_load,
   cv.montlhy_approved_load,
   cv.MINIMUM_GAS_LOAD,
   cv.load_per_hour,
cv.c_address as address,nvl(c.is_bulk,0) is_bulk,
cb.demand_charge,
       CB.LAST_DATE_PAYMENT,
       CB.ISSUE_DATE,
       C.PRE_CUST_CODE,

       0 consumption,
       0 MIXED_CONSUMPTION,
       0 AVG_CONSUMPTION,
       0 ADJUST_CONSUMPTION,
       0 EVC_ADJUSTED_CONSUMPTION,
       0 TOTAL_CONSUMPTION,
       CB.BILL_AMOUNT gas_bill,
       CB.AVG_BILL,
       CB.MIN_BILL,
       (CB.ADJUST_GAS_BILL + CB.ADJUST_METER_RENT + CB.ADJUST_OTHER)
          adjustment,
       CB.METER_CHARGE_AMOUNT,
       CB.SURCHARGE_AMOUNT,
       CB.VAT_EXEMPTION,
       round(nvl(cb.VAT_AMOUNT,0),0) VAT_AMOUNT,
       CB.ADVANCE_AMOUNT,
       CB.CURRENT_TOTAL,
       substr(MD.MONTH_NAME,0,3) || '-' || cb.bill_year "bill_month",
       cb.bill_month bill_month_sub,
       cb.bill_year,
       (SELECT get_gas_rate_date_wise4report (
                     '01/'
                  || TO_CHAR (CB.BILL_MONTH, '09')
                  || '/'
                  || CB.BILL_YEAR,
                  LAST_DAY (
                     TO_DATE (
                           '01/'
                        || TO_CHAR (CB.BILL_MONTH, '09')
                        || '/'
                        || CB.BILL_YEAR,
                        'dd/mm/yyyy')),
                  C.CUST_TYPE_ID)
          FROM DUAL)
          gas_rate_dist,
    ((cb.issue_date+cty.DAYS_FOR_DEFUALTER)-1) defualter_date,
       NVL ( (SELECT spel_out (cb.CURRENT_TOTAL) FROM DUAL), 'Zero') spelOut,
(SELECT SUBSTR(DEPARTMENT,7,5) FROM CUSTOMER_ZONE WHERE zone_name=c.zone) "dep",
cb.COMMENTS,
                  C.IS_ACTIVE
  FROM cust c JOIN DISCONNECTION_DETAIL DD ON C.CODE=DD.CUST_CODE
       JOIN customer_bill cb ON c.code = cb.cust_code
join CUST_ADDRESS_VIEW cv ON cv.code = cb.cust_code
       JOIN month_day md ON md.id = cb.bill_month
       join cust_type cty on c.cust_type_id=cty.id
WHERE c.zone=$P{zone}
 and ( $P{cust_code} is null or c.code =$P{cust_code})
 AND cb.bill_month = $P{bill_month}
 and c.cust_type_id=$P{cust_type_id}
       AND C.CONNECTION_STATUS_ID = 10396

 AND cb.bill_year = $P{bill_year}
 AND TRIM (
             TO_CHAR (TO_DATE (DD.DISCONNECTION_DATE_TIME, 'dd/mm/yy'), 'YYYY')
          || TO_CHAR (TO_DATE (DD.DISCONNECTION_DATE_TIME, 'dd/mm/yy'), 'mm'))=
       TRIM (
             TO_CHAR (TO_DATE ('1/'||$P{bill_month} ||'/'||$P{bill_year}, 'dd/mm/yy'), 'YYYY')
          || TO_CHAR (TO_DATE ('1/'||$P{bill_month}||'/'||$P{bill_year}, 'dd/mm/yy'), 'mm') )

)


union all
--layoff related customers
(SELECT C.CODE cust_code,
       C.CUST_NAME,ADJUST_SURCHARGE_DESCRIPTION,
       cty.remarks cust_type,
       cty.id cust_type_id,
       NULL PERIOD_FROM,
       NULL PERIOD_to,
       cb.id "bill_number",
       C.PHONE_NO,
       C.ZONE,
       0 ACTUAL_MINIMUM_LOAD,
     0 max_load,
   0 montlhy_approved_load,
   0 MINIMUM_GAS_LOAD,
   0 load_per_hour,
   cv.c_address as address,nvl(c.is_bulk,0) is_bulk,
0 demand_charge,
       CB.LAST_DATE_PAYMENT,
       CB.ISSUE_DATE,
       C.PRE_CUST_CODE,

       0 consumption,
       0 MIXED_CONSUMPTION,
       0 AVG_CONSUMPTION,
       0 ADJUST_CONSUMPTION,
       0 EVC_ADJUSTED_CONSUMPTION,
       0 TOTAL_CONSUMPTION,
       CB.BILL_AMOUNT gas_bill,
       CB.AVG_BILL,
       CB.MIN_BILL,
       (CB.ADJUST_GAS_BILL + CB.ADJUST_METER_RENT + CB.ADJUST_OTHER)
          adjustment,
       CB.METER_CHARGE_AMOUNT,
       CB.SURCHARGE_AMOUNT,
       CB.VAT_EXEMPTION,
       ROUND (NVL (cb.VAT_AMOUNT, 0), 0) VAT_AMOUNT,
       CB.ADVANCE_AMOUNT,
       CB.CURRENT_TOTAL,
       SUBSTR (MD.MONTH_NAME, 0, 3) || '-' || cb.bill_year "bill_month",
       cb.bill_month bill_month_sub,
       cb.bill_year,
       (SELECT get_gas_rate_date_wise4report (
                     '01/'
                  || TO_CHAR (CB.BILL_MONTH, '09')
                  || '/'
                  || CB.BILL_YEAR,
                  LAST_DAY (
                     TO_DATE (
                           '01/'
                        || TO_CHAR (CB.BILL_MONTH, '09')
                        || '/'
                        || CB.BILL_YEAR,
                        'dd/mm/yyyy')),
                  C.CUST_TYPE_ID)
          FROM DUAL)
          gas_rate_dist,
       ( (cb.issue_date + cty.DAYS_FOR_DEFUALTER) - 1) defualter_date,
       NVL ( (SELECT spel_out (cb.CURRENT_TOTAL) FROM DUAL), 'Zero') spelOut,
       (SELECT SUBSTR (DEPARTMENT, 7, 5)
          FROM CUSTOMER_ZONE
         WHERE zone_name = c.zone)
          "dep",
cb.COMMENTS,
C.IS_ACTIVE
  FROM cust c
       JOIN customer_bill cb ON c.code = CB.CUST_CODE
join CUST_ADDRESS_VIEW cv ON cv.code = cb.cust_code
       JOIN cust_type cty ON cty.id = c.cust_type_id
       JOIN month_day md ON md.id = cb.bill_month
       JOIN LAYOFF LA ON LA.CUST_CODE = C.CODE
 WHERE     cb.bill_year || TRIM (TO_CHAR (cb.bill_month, '09')) NOT IN
              (SELECT (   TO_CHAR (TO_DATE (LD.LAYOFF_DATE_TIME, 'dd/mm/YY'),
                                   'YYYY')
                       || TO_CHAR (
                             TO_DATE (LD.LAYOFF_DATE_TIME, 'dd/mm/yyyy'),
                             'mm'))
                 FROM LAYOFF L
                      JOIN LAYOFF_DETAIL LD ON L.ID = LD.LAYOFF_ID
                      JOIN cust c ON c.code = l.cust_code
                WHERE L.CUST_CODE = cb.cust_code)
     and  c.zone=$P{zone}
       AND C.CONNECTION_STATUS_ID = 12680
 and ( $P{cust_code} is null or c.code =$P{cust_code} )
 AND cb.bill_month = $P{bill_month}
 and c.cust_type_id=$P{cust_type_id}

 AND cb.bill_year =$P{bill_year}
       AND LA.STATUS <> 'Layoff Closed')
) main_q
JOIN (SELECT bf.id, BF.CAT_NAME, BF.IS_ACTIVE
                 FROM BILL_FORMAT_CATEGORIES bf) bill_f
            ON BILL_F.IS_ACTIVE = main_q.IS_ACTIVE

order by pre_cust_code,bill_f.id]]>
	</queryString>
