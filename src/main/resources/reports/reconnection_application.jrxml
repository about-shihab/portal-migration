	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<parameter name="CUST_CODE" class="java.lang.String"/>
	<parameter name="ATTACHED_NAME" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT TO_CHAR(SYSDATE, 'dd/mm/yyyy') AS application_date,
       t.code,
       t.cust_name,
       t.zone,
       TO_CHAR(latest_dd.disconnection_date, 'dd/mm/yyyy') AS disconnection_date,
       t.address
  FROM METER_UNOIN_DOM_CUST_VIEW t
 INNER JOIN (
    SELECT dd.cust_code, MAX(dd.disconnection_date_time) AS disconnection_date
      FROM disconnection_detail dd
     WHERE UPPER(dd.status) = 'APPROVED'
     GROUP BY dd.cust_code
 ) latest_dd
    ON t.code = latest_dd.cust_code
 INNER JOIN disconnection_detail dd
    ON latest_dd.cust_code = dd.cust_code
   AND latest_dd.disconnection_date = dd.disconnection_date_time
 WHERE t.code = $P{CUST_CODE}
   AND t.connection_status_id IN (
        10402,
        10396,
        10397,
        10398,
        10399,
        10400,
        12677,
        12680,
        40001,
        10101,
        10404
    )]]>
	</queryString>
