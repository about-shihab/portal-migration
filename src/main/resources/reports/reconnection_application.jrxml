			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement stretchType="RelativeToBandHeight" x="32" y="26" width="495" height="104" uuid="eb83d985-197a-4e29-9d64-89c3deaf78f1"/>
				<textElement textAlignment="Justified">
					<font fontName="Nikosh" size="16"/>
				</textElement>
				<textFieldExpression><![CDATA["সবিনয়ে বিনীত নিবেদন এই যে, গত "+$F{DISCONNECTION_DATE}+" ইং তারিখে আমার গ্যাস সংযোগ বিচ্ছিন্ন করা হয়। \n\nএমতাবস্থায় আমার বিচ্ছিন্নকৃত লাইনটি পুনঃসংযোগ প্রদান করিলে মহোদয়ের কাছে কৃতজ্ঞ থাকিব।"]]></textFieldExpression>
			</textField>
