				<reportElement x="35" y="116" width="345" height="20" uuid="16d82748-9130-4c3f-9973-54f3a291fed2"/>
				<textElement>
					<font fontName="Nikosh" size="16"/>
				</textElement>
				<text><![CDATA[কর্ণফুলী গ্যাস ডিস্ট্রিবিউশন কোম্পানী লিমিটেড, চট্টগ্রাম ।]]></text>
			</staticText>
			<staticText>
				<reportElement x="32" y="160" width="495" height="20" uuid="327d53df-96dc-4b61-b135-34c9c4906f5e"/>
				<textElement textAlignment="Center">
					<font fontName="Nikosh" size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[বিষয়ঃ পুনঃসংযোগের আবেদন ।]]></text>
			</staticText>
