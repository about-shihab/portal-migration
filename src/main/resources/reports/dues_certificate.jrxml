	<parameter name="inCUST_CODE" class="java.lang.String"/>
	<parameter name="inBILL_MONTH" class="java.lang.Long"/>
	<parameter name="inBILL_YEAR" class="java.lang.Long"/>
	<parameter name="IMAGE_DIR" class="java.lang.String"/>
	<parameter name="IsNonMeter" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT rv.COMPANY_NAME
      , rv.MOTHER_CONPANY
      , rv.COMPANY_ADDRESS_1
      ,rv.rpt_title,
       rv.rpt_part_one,
       rv.rpt_part_two,
       rv.rpt_part_three,
       rv.WARNING_MSG,
       rv.rpt_footer,
       1 as duesFlag,
       rv.rpt_cust_nm_txt,
       rv.rpt_cust_addr_txt,
       rv.rpt_cust_code_txt,
       rv.rpt_mbl_txt ,
       rv.qr_text,
      rv.google_qr_api,
       c_code,
       zone,
       mobile_no,
       CUST_NAME,
       address,
       cust_type_id,
       pre_cust_code,
       current_total,
       bill_month_count,
       SYSDATE,
       from_month,
       month_list,
       bill_year
FROM (SELECT DISTINCT (c_code),
                      zone,
                      mobile_no,
                      CUST_NAME,
                      address,
                      cust_type_id,
                      pre_cust_code,
                      current_total,
                      SUM(bill_month_count) bill_month_count,
                      SYSDATE,
                      TO_CHAR(TO_DATE($P{inBILL_MONTH}, 'mm'), 'Month') from_month,
                      month_list,
                      bill_year
      FROM (SELECT SUM(cb.bill_month)   sumList,
                   MV.CUST_NAME,
                   MV.ZONE,
                   mv.mobile_no,
                   MV.ADDRESS,
                   MV.CUST_TYPE_ID,
                   MV.CODE              c_code,
                   MV.PRE_CUST_CODE,
                   SUM (
                              DECODE (
                                 CB.STATUS,
                                 'Unpaid', NVL (CB.CURRENT_TOTAL, 0),
                                 'Pending', NVL (CB.CURRENT_TOTAL, 0),
                                 'AR-SURCHARGE', NVL (CB.SURCHARGE_AMOUNT, 0),
                                 NVL (CB.REMAINING, 0)))
                               current_total,
                   cb.cust_code,
                   cb.bill_year,
                   COUNT(cb.bill_month) bill_month_count,
                   LISTAGG(TO_CHAR(TO_DATE(cb.bill_month, 'mm'), 'Mon'), ', ')
                           WITHIN GROUP (ORDER BY cb.bill_month)
                                        month_list
            FROM customer_bill cb
                     JOIN meter_unoin_dom_cust_view mv ON mv.code = CB.CUST_CODE
            WHERE CB.STATUS <> 'Paid'
              AND cb.cust_code =$P{inCUST_CODE}--'2001NM-103582'
              AND bill_year || TRIM(TO_CHAR(bill_month, '09')) <=
                  $P{inBILL_YEAR} || TRIM(TO_CHAR($P{inBILL_MONTH}, '09'))
            GROUP BY cb.cust_code,
                     cb.bill_year,
                     MV.CUST_NAME,
                     MV.ZONE,
                     mv.mobile_no,
                     MV.ADDRESS,
                     MV.CUST_TYPE_ID,
                     MV.CODE,
                     MV.PRE_CUST_CODE
            ORDER BY cb.bill_year DESC)
      WHERE  current_total > 0
      GROUP BY c_code,
               zone,
               mobile_no,
               CUST_NAME,
               address,
               cust_type_id,
               pre_cust_code,
               current_total,
               SYSDATE,
               month_list,
               bill_year
      ORDER BY pre_cust_code, c_code, bill_year DESC),
    RPT_CERT_CONTENT_VIEW_MAMUN rv]]>
	</queryString>
